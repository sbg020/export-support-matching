# 프론트엔드 환경변수 예시 (복사해서 frontend/.env.local로 사용, 실제 값은 커밋하지 마세요)

# 공고 REST API 주소. 비워 두면 '공고 데이터 미연동' 상태(빈 목록)로 동작합니다.
# 예: Django 백엔드를 로컬에서 실행한 경우 http://localhost:8000/api
VITE_API_BASE_URL=

# ── 로그인 (서버 전용) ──
# 브라우저 번들에 들어가지 않도록 VITE_ 접두사를 붙이지 않습니다.
# npm run dev / npm run preview 의 개발 서버와 Vercel 서버 함수가 이 값을 읽습니다.
DEMO_LOGIN_ID=
DEMO_LOGIN_PASSWORD=
# 세션 서명 키: openssl rand -base64 32 (로컬·Preview·Production 각각 다른 값)
AUTH_SESSION_SECRET=
