# 프론트엔드 환경변수 예시 (복사해서 frontend/.env.local로 사용, 실제 값은 커밋하지 마세요)

# 공고 REST API 주소. 비워 두면 '공고 데이터 미연동' 상태(빈 목록)로 동작합니다.
# 예: Django 백엔드를 로컬에서 실행한 경우 http://localhost:8000/api
VITE_API_BASE_URL=

# ── 로그인 (서버 전용) ──
# 브라우저 번들에 들어가지 않도록 VITE_ 접두사를 붙이지 않습니다.
# npm run dev / npm run preview 의 개발 서버와 Vercel 서버 함수가 이 값을 읽습니다.
# 운영자(관리자 화면 /admin) 계정 — REVISION_05 §7.1. 값은 Vercel 환경변수에만 넣는다
OPS_LOGIN_ID=
OPS_LOGIN_PASSWORD=
DEMO_LOGIN_ID=
DEMO_LOGIN_PASSWORD=
# 테스트 계정 (시연·캡처용, revision_03 테스트 계정). 둘 다 있을 때만 로그인할 수 있습니다.
TEST_LOGIN_ID=
TEST_LOGIN_PASSWORD=
# 세션 서명 키: openssl rand -base64 32 (로컬·Preview·Production 각각 다른 값)
AUTH_SESSION_SECRET=

# 챗봇(공고 도우미) — 서버 전용, VITE_ 접두사 금지 (REVISION_05 §8)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=

# 공개 API 키 (쉼표로 여러 개, 서버 전용) — REVISION_05 §9
PUBLIC_API_KEYS=
# 키별 분당 호출 수 (기본 60)
PUBLIC_API_RATE_PER_MINUTE=

# 기업마당 API 인증키 (서버 전용, 수집 기능은 서버 저장소 연결 후) — REVISION_05 §7.3
BIZINFO_API_KEY=
