# backend/.env 로 복사해서 사용합니다. 실제 값은 커밋하지 마세요.
# 로컬 개발: DJANGO_DEBUG=true 이면 DJANGO_SECRET_KEY가 비어 있어도 임시 키로 실행됩니다.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=export_matching
POSTGRES_USER=export_matching
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
