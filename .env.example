# 이 저장소에서 쓰는 환경변수 이름 목록입니다. 실제 값은 커밋하지 마세요.
# 프론트엔드: frontend/.env.local 로 복사 / 백엔드: backend/.env 로 복사

# ── frontend (Vite) ──
# 공고 REST API 주소. 비워 두면 '공고 데이터 미연동' 상태(빈 목록)로 동작합니다.
VITE_API_BASE_URL=

# ── frontend 서버 함수 (로그인) — 서버 전용. VITE_ 접두사를 붙이지 마세요 ──
# 데모 계정 아이디·비밀번호와 세션 서명 키 (openssl rand -base64 32). 환경마다 다른 키를 씁니다.
# 운영자(관리자 화면 /admin) 계정 — REVISION_05 §7.1. 값은 Vercel 환경변수에만 넣는다
OPS_LOGIN_ID=
OPS_LOGIN_PASSWORD=
DEMO_LOGIN_ID=
DEMO_LOGIN_PASSWORD=
# 테스트 계정 (시연·캡처용). 둘 다 있을 때만 로그인할 수 있습니다.
TEST_LOGIN_ID=
TEST_LOGIN_PASSWORD=
# 시연용 기업 계정 '이퓨쳐' (역할 test, 아이디 USER). 비밀번호는 커밋하지 않는다
EFUTURE_LOGIN_ID=
EFUTURE_LOGIN_PASSWORD=
AUTH_SESSION_SECRET=

# ── backend (Django) ──
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# ── PostgreSQL ──
POSTGRES_DB=export_matching
POSTGRES_USER=export_matching
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# 챗봇(공고 도우미) — 서버 전용, VITE_ 접두사 금지 (REVISION_05 §8)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=

# 공개 API 키 (쉼표로 여러 개, 서버 전용) — REVISION_05 §9
PUBLIC_API_KEYS=
# 키별 분당 호출 수 (기본 60)
PUBLIC_API_RATE_PER_MINUTE=

# 기업마당 API 인증키 (서버 전용, 수집 기능은 서버 저장소 연결 후) — REVISION_05 §7.3
BIZINFO_API_KEY=
