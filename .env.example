# 이 저장소에서 쓰는 환경변수 이름 목록입니다. 실제 값은 커밋하지 마세요.
# 프론트엔드: frontend/.env.local 로 복사 / 백엔드: backend/.env 로 복사

# ── frontend (Vite) ──
# 공고 REST API 주소. 비워 두면 '공고 데이터 미연동' 상태(빈 목록)로 동작합니다.
VITE_API_BASE_URL=
# 공고 데이터 소스. test-dataset이면 정답 세트 초안으로 만든 테스트 데이터셋(검수 전)을 씁니다.
# VITE_API_BASE_URL이 있으면 API가 우선합니다. 비워 두면 빈 저장소. (빌드 시점에 들어가므로 바꾼 뒤 다시 배포)
VITE_DATA_SOURCE=

# ── frontend 서버 함수 (로그인) — 서버 전용. VITE_ 접두사를 붙이지 마세요 ──
# 데모 계정 아이디·비밀번호와 세션 서명 키 (openssl rand -base64 32). 환경마다 다른 키를 씁니다.
DEMO_LOGIN_ID=
DEMO_LOGIN_PASSWORD=
# 테스트 계정 (시연·캡처용). 둘 다 있을 때만 로그인할 수 있습니다.
TEST_LOGIN_ID=
TEST_LOGIN_PASSWORD=
AUTH_SESSION_SECRET=

# ── backend (Django) ──
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# ── PostgreSQL ──
POSTGRES_DB=export_matching
POSTGRES_USER=export_matching
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
